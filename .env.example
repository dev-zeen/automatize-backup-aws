# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
S3_BUCKET=my-bucket
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — custom endpoint for S3-compatible services (MinIO, R2, etc.)
# S3_ENDPOINT=https://s3.us-east-2.amazonaws.com

# Cron expression for backup schedule (default: daily at 2am UTC)
BACKUP_SCHEDULE=0 2 * * *

# How many days to keep backups in S3 (default: 30)
RETENTION_DAYS=7

# S3 key prefix for backup files (default: db-backups)
S3_PREFIX=db-backups

# Run a backup immediately when the container starts (default: false)
RUN_ON_START=true
